    {
      "parameters": {
        "jsCode": "const rawText = $json.output?.[0]?.content?.[0]?.text;\n\nif (!rawText) {\n  throw new Error(\"No AI output received.\");\n}\n\nconst ai = JSON.parse(rawText);\n\n// Helper\nfunction toBoolean(value) {\n  return value === true || String(value).toLowerCase() === \"true\";\n}\n\n// AI Signals\nconst isSalesInquiry = toBoolean(ai.is_sales_inquiry);\nconst asksForMeeting = toBoolean(ai.asks_for_meeting);\nconst asksForInformation = toBoolean(ai.asks_for_information);\nconst requiresReply = toBoolean(ai.requires_reply);\n\n// Category\nlet category = \"Other\";\n\nif (isSalesInquiry) {\n  category = \"Sales\";\n}\n\n// Priority\nlet priority = \"Low\";\n\nif (asksForMeeting) {\n  priority = \"High\";\n} else if (\n  isSalesInquiry ||\n  asksForInformation ||\n  requiresReply\n) {\n  priority = \"Medium\";\n}\n\n// Sentiment\nconst sentiment = ai.sentiment || \"Neutral\";\n\n// Summary\nconst summary = ai.summary || \"No summary generated.\";\n\n// Suggested Action\nconst suggestedAction =\n  ai.suggested_action ||\n  (requiresReply\n    ? \"Review and reply to the email.\"\n    : \"No action needed.\");\n\n// Gmail Data\nconst gmail = $(\"Gmail Trigger\").item.json;\n\n// Final Output\nreturn [\n  {\n    json: {\n      received_at: new Date().toISOString(),\n\n      message_id: gmail.id || \"\",\n      thread_id: gmail.threadId || \"\",\n\n      sender: gmail.From || \"\",\n      recipient: gmail.To || \"\",\n      subject: gmail.Subject || \"\",\n      email_preview: gmail.snippet || \"\",\n\n      category,\n      priority,\n      sentiment,\n      summary,\n      suggested_action: suggestedAction,\n\n      is_sales_inquiry: isSalesInquiry,\n      asks_for_meeting: asksForMeeting,\n      asks_for_information: asksForInformation,\n      requires_reply: requiresReply,\n\n      status: \"New\"\n    }\n  }\n];"
      },
