        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an email signal extractor for an AI automation business.\n\nRead the incoming email carefully.\n\nDetermine these fields:\n\n1. is_sales_inquiry\ntrue if the sender is interested in our services or asks about our services.\n\n2. asks_for_meeting\ntrue ONLY if the sender explicitly asks for a call, meeting, demo, consultation, appointment, or scheduling.\n\n3. asks_for_information\ntrue if the sender asks for information, details, explanations, features, pricing, services offered, industries served, or how something works.\n\n4. requires_reply\ntrue if the sender asks a question or otherwise expects a response.\n\n5. sentiment\nMust be exactly one of:\n- Positive\n- Neutral\n- Negative\n\nUse:\n- Positive when the sender is interested, enthusiastic, appreciative, or optimistic.\n- Neutral when the message is factual or emotionally neutral.\n- Negative when the sender expresses frustration, dissatisfaction, anger, or disappointment.\n\n6. summary\nWrite one short sentence describing what the sender wants or why they emailed.\n\n7. suggested_action\nWrite one short practical next step for the inbox owner.\n\nImportant rules:\n- Use only information explicitly present in the email.\n- Do not invent a meeting, budget, complaint, urgency, or request.\n- Do not infer a meeting from general interest.\n- Keep summary and suggested_action concise.\n- Return ONLY valid JSON.\n- Do not use markdown or code fences.\n\nReturn exactly:\n\n{\n  \"is_sales_inquiry\": true or false,\n  \"asks_for_meeting\": true or false,\n  \"asks_for_information\": true or false,\n  \"requires_reply\": true or false,\n  \"sentiment\": \"Positive | Neutral | Negative\",\n  \"summary\": \"one short sentence\",\n  \"suggested_action\": \"one short practical action\"\n}"
            },
            {
              "content": "=Analyze this email:\n\nSender:\n{{ $('Gmail Trigger').item.json.From }}\n\nSubject:\n{{ $('Gmail Trigger').item.json.Subject }}\n\nEmail:\n{{ $('Gmail Trigger').item.json.snippet }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
