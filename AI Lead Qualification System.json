        "jsCode": "return items.map(item => {\n\n  const lead = JSON.parse(item.json.choices[0].message.content);\n\n  return {\n    json: {\n      timestamp: new Date().toLocaleString(\"en-PH\", {\n\n  timeZone: \"Asia/Manila\"\n\n}),\n\n      name: lead.name || \"\",\n      email: lead.email || \"\",\n      phone: lead.phone || \"\",\n      service: lead.service || \"\",\n      budget: lead.budget || \"\",\n      urgency: lead.urgency || \"Unknown\",\n      lead_quality: lead.lead_quality || \"Cold\",\n      reason: lead.reason || \"\",\n      status: \"New Lead\"\n    }\n  };\n})"
