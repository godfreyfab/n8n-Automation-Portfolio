    {
      "parameters": {
        "jsCode": "const rawText = $json.output?.[0]?.content?.[0]?.text;\n\nif (!rawText) {\n  throw new Error(\n    `Email AI returned no text. Received: ${JSON.stringify($json)}`\n  );\n}\n\nconst cleanedText = rawText\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet email;\n\ntry {\n  email = JSON.parse(cleanedText);\n} catch (error) {\n  throw new Error(`Email AI returned invalid JSON: ${rawText}`);\n}\n\nif (\n  typeof email.subject !== \"string\" ||\n  typeof email.body !== \"string\" ||\n  !email.subject.trim() ||\n  !email.body.trim()\n) {\n  throw new Error(\n    `Email AI did not return a valid subject and body: ${cleanedText}`\n  );\n}\n\nreturn [\n  {\n    json: {\n      subject: email.subject.trim(),\n      body: email.body.trim(),\n    },\n  },\n];"
      },
