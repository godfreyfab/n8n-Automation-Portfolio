        "jsCode": "const rawContent = $json.output?.[0]?.content?.[0]?.text;\n\nif (!rawContent) {\n  throw new Error(\n    `OpenAI text was not found. Received: ${JSON.stringify($json)}`\n  );\n}\n\nconst cleanedContent = rawContent\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet lead;\n\ntry {\n  lead = JSON.parse(cleanedContent);\n} catch (error) {\n  throw new Error(`OpenAI returned invalid JSON: ${rawContent}`);\n}\n\n// Manila Time\nconst timestamp = new Date().toLocaleString(\"en-PH\", {\n  timeZone: \"Asia/Manila\",\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\",\n  hour: \"2-digit\",\n  minute: \"2-digit\",\n  second: \"2-digit\",\n  hour12: false,\n});\n\nreturn [\n  {\n    json: {\n      timestamp,\n      ...lead\n    }\n  }\n];"
      },
