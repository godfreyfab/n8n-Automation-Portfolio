    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a customer support ticket classifier.\n\nReturn valid JSON only:\n\n{\n  \"department\": \"\",\n  \"priority\": \"\",\n  \"sentiment\": \"\",\n  \"summary\": \"\",\n  \"suggested_action\": \"\"\n}\n\nDepartment rules:\n\nSales = an inbound prospective customer showing interest in purchasing the company's products or services.\n\nPromotional emails, newsletters, advertisements, vendor pitches, and unsolicited offers sent TO the company are not Sales inquiries. Classify these as Other with Low priority unless they contain a genuine business request requiring attention.\n\nSupport = needs help resolving a technical or service issue.\nBilling = payments, charges, invoices, refunds, subscriptions.\nComplaint = dissatisfaction with service or handling of an issue, especially repeated unresolved problems, broken promises, poor treatment, escalation, or cancellation threats.\nOther = does not clearly fit the categories above.\n\nIf a message contains both a support issue and a complaint, classify it as Complaint when the main focus is dissatisfaction with how the issue was handled rather than simply asking for technical help.\n\nWhen multiple departments could apply, classify based on the customer's primary problem and requested resolution, not simply keywords or topics mentioned.\n\nBilling = the customer needs a payment, charge, invoice, refund, or billing problem resolved.\nSupport = the customer needs a product, account, access, or technical problem resolved, even if payment or subscription details are mentioned as context.\n\n\nPriority:\nUrgent = immediate risk, fraud/security, major outage, repeated unresolved issue, cancellation threat\nHigh = payment/refund issue, account access issue, serious service problem\nMedium = normal support or sales inquiry\nLow = informational or non-urgent request\n\nSentiment:\nPositive = satisfaction, excitement, appreciation\nNeutral = informational or factual with no problem\nNegative = problem, error, inconvenience, incorrect charge, refund need, dissatisfaction\n\nIf something went wrong for the customer, sentiment should usually be Negative even if they are polite.\n\nKeep summary concise.\nKeep suggested_action actionable.\nReturn JSON only."
            },
            {
              "content": "=Analyze this customer support ticket.\n\nCustomer message:\n{{ $json.snippet }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        208,
        0
      ],
      "id": "b11e5a7d-425e-4079-a5b0-0ba57fd3ad00",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet aiData = {};\n\ntry {\n  // Get the AI response text from Message a Model\n  let content =\n    input.output?.[0]?.content?.[0]?.text ?? \"\";\n\n  // Remove markdown code fences if OpenAI returns:\n  // ```json\n  // { ... }\n  // ```\n  content = content\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/```$/i, \"\")\n    .trim();\n\n  // Convert the JSON string into a JavaScript object\n  aiData = JSON.parse(content);\n\n} catch (error) {\n  // If parsing fails, use an empty object\n  aiData = {};\n}\n\n\n// -------------------------\n// ALLOWED VALUES\n// -------------------------\n\nconst validDepartments = [\n  \"Sales\",\n  \"Support\",\n  \"Billing\",\n  \"Complaint\",\n  \"Other\"\n];\n\nconst validPriorities = [\n  \"Low\",\n  \"Medium\",\n  \"High\",\n  \"Urgent\"\n];\n\nconst validSentiments = [\n  \"Positive\",\n  \"Neutral\",\n  \"Negative\"\n];\n\n\n// -------------------------\n// VALIDATE AI OUTPUT\n// -------------------------\n\nconst department = validDepartments.includes(aiData.department)\n  ? aiData.department\n  : \"Other\";\n\nconst priority = validPriorities.includes(aiData.priority)\n  ? aiData.priority\n  : \"Low\";\n\nconst sentiment = validSentiments.includes(aiData.sentiment)\n  ? aiData.sentiment\n  : \"Neutral\";\n\n\n// -------------------------\n// GET ORIGINAL GMAIL DATA\n// -------------------------\n\nconst gmail = $('Gmail Trigger').first().json;\n\n\n// -------------------------\n// FINAL OUTPUT\n// -------------------------\n\nreturn [\n  {\n    json: {\n      timestamp: new Date().toISOString(),\n\n      sender: gmail.From ?? \"Unknown\",\n      subject: gmail.Subject ?? \"No Subject\",\n      message: gmail.snippet ?? \"\",\n\n      department: department,\n      priority: priority,\n      sentiment: sentiment,\n\n      summary:\n        aiData.summary ?? \"No summary generated\",\n\n      suggested_action:\n        aiData.suggested_action ?? \"Manual review recommended\",\n\n      status: \"New Ticket\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
